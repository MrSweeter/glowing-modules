# Data source used by `npm run dev`.
#   local  -> public/data/glowing-modules-diff.json (refresh with `npm run data:pull`)
#   remote -> the live gist
#   <url>  -> any URL or same-origin path serving the same JSON format
# In dev only, `?data=local|remote|<path>` in the page URL overrides this value.
VITE_DATA_SOURCE=local
